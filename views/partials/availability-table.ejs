<div class="table-card"><table class="data-table"><thead><tr><th>Cabin class</th><th>Total</th><th>Sold</th><th>Free</th></tr></thead><tbody><% (availability || []).forEach(function(a) { %><tr><td data-label="Cabin class"><%= a.SeatClass %></td><td data-label="Total"><%= a.total_seats %></td><td data-label="Sold"><%= a.sold %></td><td data-label="Free"><strong><%= a.free %></strong></td></tr><% }); %></tbody></table><% if (!availability || !availability.length) { %><p class="empty-state">No seat availability is available.</p><% } %></div>
