<%- include('../partials/header', { title }) %>

<h1>Passengers</h1>
<% if (error) { %>
  <p class="error-message"><%= error %></p>
<% } %>
<p><a href="/passengers/new">+ Add passenger</a></p>

<table class="data-table">
  <thead>
    <tr>
      <th>Name</th>
      <th>Passport No.</th>
      <th>Phone</th>
      <th>Email</th>
      <th>Membership</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <!-- [Phase 5 · Frontend · Kornnaphat] `passengers` is the array passed from
         passengerController.list - loop over it the same way for any
         other list page (flights, reservations, ...). -->
    <% passengers.forEach(function(p) { %>
      <tr>
        <td><%= p.Name %></td>
        <td><%= p.PassportNo %></td>
        <td><%= p.PhoneNo %></td>
        <td><%= p.Email %></td>
        <td><%= p.MembershipStatus %></td>
        <td>
          <a href="/passengers/<%= p.PassengerID %>/edit">Edit</a>
          <form action="/passengers/<%= p.PassengerID %>/delete" method="POST" data-confirm="Delete this passenger?" style="display:inline">
            <button type="submit">Delete</button>
          </form>
        </td>
      </tr>
    <% }); %>
  </tbody>
</table>

<%- include('../partials/footer') %>
