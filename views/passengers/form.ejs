<%- include('../partials/header', { title }) %>

<h1><%= title %></h1>

<!-- [Phase 5 · Frontend · Kornnaphat] Same form template handles both "add" and "edit":
     `passenger` is null on the add page (empty fields) and a real row on
     the edit page (pre-filled). The form posts to a different URL
     depending on which case it is. -->
<form
  action="<%= passenger ? ('/passengers/' + passenger.PassengerID) : '/passengers' %>"
  method="POST"
  class="stacked-form"
>
  <label>
    Name
    <input type="text" name="Name" value="<%= passenger ? passenger.Name : '' %>" required>
  </label>

  <label>
    Passport No.
    <input type="text" name="PassportNo" value="<%= passenger ? passenger.PassportNo : '' %>" required>
  </label>

  <label>
    Phone
    <input type="text" name="PhoneNo" value="<%= passenger ? passenger.PhoneNo : '' %>">
  </label>

  <label>
    Email
    <input type="email" name="Email" value="<%= passenger ? passenger.Email : '' %>">
  </label>

  <label>
    Membership status
    <select name="MembershipStatus">
      <% ['Normal', 'Silver', 'Gold'].forEach(function(level) { %>
        <option value="<%= level %>" <%= passenger && passenger.MembershipStatus === level ? 'selected' : '' %>>
          <%= level %>
        </option>
      <% }); %>
    </select>
  </label>

  <button type="submit">Save</button>
</form>

<%- include('../partials/footer') %>
