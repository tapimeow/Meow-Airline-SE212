<%- include('../partials/header', { title }) %>
<header class="page-head"><div><p class="eyebrow">Reservation #<%= reservation.ReservationID %></p><h1><%= reservation.PassengerName %></h1></div><a href="/reservations">All reservations</a></header>
<% if (error) { %><p class="error-message"><%= error %></p><% } %>
<section class="summary-grid"><article class="summary-card"><span>Booking date</span><strong><%= reservation.BookingDate %></strong></article><article class="summary-card"><span>Status</span><strong><%= reservation.ReservationStatus %></strong></article></section>
<div class="section-title"><div><p class="eyebrow">Travellers</p><h2>Tickets</h2></div></div>
<div class="table-card"><table class="data-table"><thead><tr><th>Traveller</th><th>Flight</th><th>Departure</th><th>Seat</th><th>Fare</th><th>Ticket status</th><th></th></tr></thead><tbody><% tickets.forEach(function(t) { %><tr><td data-label="Traveller"><%= t.TravellerName %></td><td data-label="Flight"><%= t.FlightNo || '—' %></td><td data-label="Departure"><%= t.DepartureTime ? formatFlightTime(t.DepartureTime) : '—' %></td><td data-label="Seat"><%= t.SeatNo %></td><td data-label="Fare"><%= Number(t.Price).toFixed(2) %> THB</td><td data-label="Ticket status"><%= t.TicketStatus %></td><td data-label="Actions"><a class="btn btn-sm btn-quiet" href="/tickets/<%= t.TicketID %>">Ticket</a><% if (t.TicketStatus === 'booked') { %><form action="/tickets/<%= t.TicketID %>/issue" method="POST"><button class="btn btn-sm">Issue</button></form><% } %></td></tr><% }); %></tbody></table><% if (!tickets.length) { %><p class="empty-state">No tickets in this reservation.</p><% } %></div>
<div class="section-title"><div><p class="eyebrow">Ledger</p><h2>Payments</h2></div><a class="btn" href="/reservations/<%= reservation.ReservationID %>/payments">Record payment</a></div>
<div class="table-card"><table class="data-table"><thead><tr><th>Payment</th><th>Amount</th><th>Method</th><th>Status</th><th>Timestamp</th><th></th></tr></thead><tbody><% payments.forEach(function(p) { %><tr><td data-label="Payment">#<%= p.PaymentID %></td><td data-label="Amount"><%= Number(p.TotalAmount).toFixed(2) %> THB</td><td data-label="Method"><%= p.PaymentMethod %></td><td data-label="Status"><%= p.Status %></td><td data-label="Timestamp"><%= p.TimeStamp %></td><td data-label="Actions"><% if (p.Status === 'Paid') { %><form action="/payments/<%= p.PaymentID %>/refund" method="POST" data-confirm="Refund this payment? The reservation may return to Held."><button class="btn btn-sm btn-danger">Refund</button></form><% } %></td></tr><% }); %></tbody></table><% if (!payments.length) { %><p class="empty-state">No payments yet.</p><% } %></div>
<form class="form-actions" action="/reservations/<%= reservation.ReservationID %>/cancel" method="POST" data-confirm="Cancel this reservation and its tickets?"><button class="btn btn-danger">Cancel reservation</button></form>
<%- include('../partials/footer') %>
