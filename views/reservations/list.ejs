<%- include('../partials/header', { title }) %>
<header class="page-head"><div><p class="eyebrow">Passenger journeys</p><h1>Reservations</h1></div><a class="btn" href="/reservations/new">New booking</a></header>
<% if (error) { %><p class="error-message"><%= error %></p><% } %>
<form class="filter-form" action="/reservations" method="GET"><label>Passenger<select name="passengerId" data-search><option value="">All passengers</option><% (passengers || []).forEach(function(p) { %><option value="<%= p.PassengerID %>" <%= filters && String(filters.passengerId) === String(p.PassengerID) ? 'selected' : '' %>><%= p.Name %> · <%= p.PassportNo %></option><% }); %></select></label><label>Status<select name="status"><option value="">All statuses</option><% ['Held','Confirmed','Cancelled'].forEach(function(s) { %><option <%= filters && filters.status === s ? 'selected' : '' %>><%= s %></option><% }); %></select></label><button class="btn btn-quiet">Filter</button></form>
<div class="table-card"><table class="data-table"><thead><tr><th>Reservation</th><th>Passenger</th><th>Booking date</th><th>Status</th><th></th></tr></thead><tbody><% reservations.forEach(function(r) { %><tr><td data-label="Reservation"><a href="/reservations/<%= r.ReservationID %>">#<%= r.ReservationID %></a></td><td data-label="Passenger"><%= r.PassengerName %></td><td data-label="Booking date"><%= r.BookingDate %></td><td data-label="Status"><span class="status-pill"><%= r.ReservationStatus %></span></td><td data-label="Open"><a class="btn btn-sm btn-quiet" href="/reservations/<%= r.ReservationID %>">Details</a></td></tr><% }); %></tbody></table><% if (!reservations.length) { %><p class="empty-state">No reservations found.</p><% } %></div>
<%- include('../partials/footer') %>
