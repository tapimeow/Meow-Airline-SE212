<%- include('../partials/header', { title }) %>
<header class="page-head"><div><p class="eyebrow">Booking flow</p><h1>New reservation</h1></div><a href="/reservations">Back to reservations</a></header>
<% if (error) { %><p class="error-message"><%= error %></p><% } %>
<script type="application/json" id="booking-data"><%- JSON.stringify({ fares: locals.fares || [], seats: locals.seats || [], tickets: locals.tickets || [] }).replace(/</g, '\\u003c') %></script>
<form class="stacked-form booking-form" action="/reservations" method="POST" data-booking-form>
  <label>Booked by<select name="BookingStaffID"><option value="">Online booking</option><% (staff || []).forEach(function(s) { %><option value="<%= s.StaffID %>" <%= reservation && String(reservation.BookingStaffID) === String(s.StaffID) ? 'selected' : '' %>><%= s.StaffName %> (booking staff)</option><% }); %></select></label>
  <div class="section-title"><h2>Traveller tickets</h2><button class="btn btn-sm btn-quiet" type="button" data-add-ticket-row>+ Add traveller</button></div>
  <div class="ticket-builders" data-ticket-rows><div class="ticket-builder" data-ticket-row><label>Traveller name<input name="Tickets[0][Name]" required maxlength="100" autocomplete="off" placeholder="Full name as in passport"></label><label>Passport no.<input name="Tickets[0][PassportNo]" required maxlength="20" autocomplete="off" placeholder="e.g. AA1234567"></label><label>Flight<select name="Tickets[0][FlightID]" required><option value="">Choose flight</option><% flights.forEach(function(f) { %><option value="<%= f.FlightID %>" <%= reservation && String(reservation.FlightID) === String(f.FlightID) ? 'selected' : '' %>><%= f.FlightNo %> · <%= f.OriginCode %> → <%= f.DestinationCode %> · <%= formatFlightTime(f.DepartureTime) %></option><% }); %></select></label><label>Fare<select name="Tickets[0][FareID]" required><option value="">Select flight first</option></select></label><label>Free seat<select name="Tickets[0][SeatID]" required><option value="">Select flight first</option></select></label><button class="text-button" type="button" data-remove-ticket-row hidden>Remove traveller</button></div></div>
  <p class="muted">Each traveller needs one ticket. A new passport number adds the traveller as a new passenger; a passport already on file uses that passenger. The first traveller is the reservation’s passenger. Seat availability is confirmed when the reservation is saved.</p><div class="form-actions"><button class="btn">Create reservation</button><a class="btn btn-quiet" href="/reservations">Cancel</a></div>
</form>
<%- include('../partials/footer') %>
