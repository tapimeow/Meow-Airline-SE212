<%- include('../partials/header', { title }) %>

<header class="page-head">
  <div><p class="eyebrow">Decision support</p><h1>Reports</h1></div>
</header>
<% if (error) { %><p class="error-message"><%= error %></p><% } %>
<p class="page-intro">Use current booking data to check seat availability, passenger bookings and route performance.</p>

<section class="report-grid" aria-label="Available reports">
  <article class="report-card">
    <span class="report-number">01</span><h2>Free seats</h2>
    <p>Compare total, sold and available seats by cabin class for a flight.</p>
    <a class="btn" href="/reports/free-seats">Open report</a>
  </article>
  <article class="report-card">
    <span class="report-number">02</span><h2>Passenger bookings</h2>
    <p>Review a passenger’s itineraries and whether each reservation is paid.</p>
    <a class="btn" href="/reports/passenger-bookings">Open report</a>
  </article>
  <article class="report-card">
    <span class="report-number">03</span><h2>Route income</h2>
    <p>Compare fare income and seats sold by route for a selected month.</p>
    <a class="btn" href="/reports/route-income">Open report</a>
  </article>
</section>

<%- include('../partials/footer') %>
