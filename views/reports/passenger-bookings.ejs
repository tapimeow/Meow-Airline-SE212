<%- include('../partials/header', { title }) %>

<header class="page-head"><div><p class="eyebrow">Report 02</p><h1>Passenger bookings</h1></div><a href="/reports">All reports</a></header>
<% if (error) { %><p class="error-message"><%= error %></p><% } %>
<p class="page-intro">Type a passenger's name or passport number to review their reservations, itineraries and payment status.</p>
<form class="filter-form" action="/reports/passenger-bookings" method="GET">
  <label for="q">Passenger</label>
  <input id="q" type="search" name="q" value="<%= locals.q || '' %>" placeholder="Type a name or passport number" autocomplete="off" required>
  <button type="submit">Search</button>
</form>

<% if (locals.matches && matches.length > 1) { %>
  <p class="summary-note"><%= matches.length %> passengers match "<%= q %>". Choose one:</p>
  <div class="table-card report-table-wrap"><table class="data-table">
    <thead><tr><th>Name</th><th>Passport no.</th><th></th></tr></thead>
    <tbody><% matches.forEach(function(m) { %><tr><td data-label="Name"><%= m.Name %></td><td data-label="Passport no."><%= m.PassportNo %></td>
      <td data-label="Open"><a class="btn btn-sm btn-quiet" href="/reports/passenger-bookings?passengerId=<%= m.PassengerID %>">Show bookings</a></td></tr><% }); %></tbody>
  </table></div>
<% } %>
<% if (locals.passenger) { %><p class="summary-note">Bookings made by <strong><%= passenger.Name %></strong> · <%= passenger.PassportNo %></p><% } %>

<% if (selectedPassengerId) { %>
  <% if (results && results.length) { %>
    <div class="table-card report-table-wrap"><table class="data-table">
      <thead><tr><th>Reservation</th><th>Flight</th><th>Route</th><th>Departure</th><th>Traveller</th><th>Ticket</th><th>Payment</th><th>Amount</th></tr></thead>
      <tbody><% results.forEach(function(row) { var unpaid = row.payment_status === 'NOT PAID' || row.payment_status === 'PARTIALLY PAID'; %><tr class="<%= unpaid ? 'row-attention' : '' %>">
        <td data-label="Reservation">#<%= row.ReservationID %><br><span class="muted"><%= row.ReservationStatus %></span></td>
        <td data-label="Flight"><%= row.FlightNo || '—' %></td><td data-label="Route"><%= row.OriginCode && row.DestinationCode ? row.OriginCode + ' → ' + row.DestinationCode : '—' %></td>
        <td data-label="Departure"><%= row.DepartureTime ? formatFlightTime(row.DepartureTime) : '—' %></td><td data-label="Traveller"><%= row.traveller || '—' %></td>
        <td data-label="Ticket"><%= row.TicketStatus || '—' %></td><td data-label="Payment"><span class="status-pill <%= unpaid ? 'status-unpaid' : 'status-paid' %>"><%= row.payment_status %></span></td>
        <td data-label="Amount"><%= Number(row.amount_paid || 0).toFixed(2) %> / <%= Number(row.total_due || 0).toFixed(2) %> THB</td>
      </tr><% }); %></tbody>
    </table></div>
  <% } else { %><p class="empty-state">No bookings were found for this passenger.</p><% } %>
<% } %>

<%- include('../partials/footer') %>
