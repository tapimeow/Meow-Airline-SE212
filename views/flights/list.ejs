<%- include('../partials/header', { title }) %>
<header class="page-head"><div><p class="eyebrow">Schedules & routes</p><h1>Flights</h1></div><a class="btn" href="/flights/new">Schedule flight</a></header>
<% if (error) { %><p class="error-message"><%= error %></p><% } %>
<form class="filter-form" method="GET" action="/flights"><label>Origin<select name="origin"><option value="">All airports</option><% (airports || []).forEach(function(a) { %><option value="<%= a.AirportCode %>" <%= filters && filters.origin === a.AirportCode ? 'selected' : '' %>><%= a.AirportCode %> · <%= a.City %></option><% }); %></select></label><label>Destination<select name="destination"><option value="">All airports</option><% (airports || []).forEach(function(a) { %><option value="<%= a.AirportCode %>" <%= filters && filters.destination === a.AirportCode ? 'selected' : '' %>><%= a.AirportCode %> · <%= a.City %></option><% }); %></select></label><label>Departure date<input name="date" type="date" value="<%= filters ? filters.date : '' %>"></label><button class="btn">Search</button></form>
<div class="table-card"><table class="data-table"><thead><tr><th>Flight</th><th>Route</th><th>Departure</th><th>Arrival</th><th>Gate</th><th>Status</th><th>Actions</th></tr></thead><tbody><% flights.forEach(function(f) { %><tr><td data-label="Flight"><strong><%= f.FlightNo %></strong></td><td data-label="Route"><%= f.OriginCode %> → <%= f.DestinationCode %></td><td data-label="Departure"><%= formatFlightTime(f.DepartureTime) %></td><td data-label="Arrival"><%= formatFlightTime(f.ArrivalTime) %></td><td data-label="Gate"><%= f.Gate || 'TBA' %></td><td data-label="Status"><span class="status-pill"><%= f.Status %></span></td><td data-label="Actions"><span class="action-row"><a class="btn btn-sm btn-quiet" href="/flights/<%= f.FlightID %>">Details</a><a class="btn btn-sm" href="/reservations/new?flightId=<%= f.FlightID %>">Book</a></span></td></tr><% }); %></tbody></table><% if (!flights.length) { %><p class="empty-state">No flights match your search.</p><% } %></div>
<%- include('../partials/footer') %>
