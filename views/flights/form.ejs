<%- include('../partials/header', { title }) %>
<header class="page-head"><div><p class="eyebrow">Schedules & routes</p><h1><%= title %></h1></div><a href="/flights">Back to flights</a></header>
<% if (error) { %><p class="error-message"><%= error %></p><% } %>
<form class="stacked-form" action="<%= editing ? '/flights/' + flight.FlightID : '/flights' %>" method="POST">
  <label>Flight route<select name="FlightNo" required <%= editing ? 'disabled' : '' %>><option value="">Choose a route</option><% routes.forEach(function(r) { %><option value="<%= r.FlightNo %>" <%= flight && flight.FlightNo === r.FlightNo ? 'selected' : '' %>><%= r.FlightNo %> · <%= r.OriginCode %> → <%= r.DestinationCode %></option><% }); %></select></label>
  <label>Aircraft<select name="AircraftID" required><option value="">Choose aircraft</option><% aircraft.forEach(function(a) { %><option value="<%= a.AircraftID %>" <%= flight && String(flight.AircraftID) === String(a.AircraftID) ? 'selected' : '' %>><%= a.AircraftModel %> · #<%= a.AircraftID %></option><% }); %></select></label>
  <label>Departure<input type="datetime-local" name="DepartureTime" value="<%= flight ? String(flight.DepartureTime).replace(' ', 'T').slice(0,16) : '' %>" required></label><label>Arrival<input type="datetime-local" name="ArrivalTime" value="<%= flight ? String(flight.ArrivalTime).replace(' ', 'T').slice(0,16) : '' %>" required></label>
  <label>Status<select name="Status"><% ['OnTime','Delayed','Cancelled'].forEach(function(s) { %><option value="<%= s %>" <%= flight && flight.Status === s ? 'selected' : '' %>><%= s %></option><% }); %></select></label><label>Gate<input name="Gate" maxlength="5" value="<%= flight && flight.Gate ? flight.Gate : '' %>"></label>
  <div class="form-actions"><button class="btn">Save flight</button><a class="btn btn-quiet" href="/flights">Cancel</a></div>
</form>
<%- include('../partials/footer') %>
