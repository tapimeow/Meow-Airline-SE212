<%- include('../partials/header', { title }) %>
<header class="page-head"><div><p class="eyebrow">Ticket #<%= ticket.TicketID %></p><h1>Baggage</h1></div><a href="/tickets/<%= ticket.TicketID %>">Back to ticket</a></header>
<% if (error) { %><p class="error-message"><%= error %></p><% } %>
<section class="summary-grid"><article class="summary-card"><span>Passenger</span><strong><%= ticket.Traveller %></strong></article><article class="summary-card"><span>Cabin class</span><strong><%= ticket.SeatClass %></strong></article><article class="summary-card"><span>Weight allowance</span><strong><%= weightLimit %> kg</strong></article><article class="summary-card"><span>Remaining</span><strong><%= Number(weightLimit - totalWeight).toFixed(2) %> kg</strong></article></section>
<div class="table-card"><table class="data-table"><thead><tr><th>Bag</th><th>Weight</th><th>Status</th><th></th></tr></thead><tbody><% baggage.forEach(function(b) { %><tr><td data-label="Bag">#<%= b.BaggageID %></td><td data-label="Weight"><%= Number(b.Weight).toFixed(2) %> kg</td><td data-label="Status"><%= b.BaggageStatus %></td><td data-label="Actions"><form action="/baggage/<%= b.BaggageID %>/delete" method="POST" data-confirm="Remove this bag?"><button class="btn btn-sm btn-danger">Remove</button></form></td></tr><% }); %></tbody></table><% if (!baggage.length) { %><p class="empty-state">No bags recorded for this ticket.</p><% } %></div>
<form class="filter-form" action="/tickets/<%= ticket.TicketID %>/baggage" method="POST"><label>Weight (kg)<input type="number" name="Weight" min="0.1" max="32" step="0.1" required></label><button class="btn">Add baggage</button></form>
<%- include('../partials/footer') %>
