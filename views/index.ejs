<%- include('partials/header', { title }) %>

<section class="welcome-panel">
  <div>
    <p class="eyebrow">Your regional airline desk</p>
    <h1>Good day. Ready for takeoff?</h1>
    <p>Keep bookings, flight operations and passenger reports together in one place.</p>
    <a class="btn" href="/reservations/new">Create a booking</a>
  </div>
  <div class="welcome-stamp" aria-hidden="true"><svg viewBox="0 0 120 120"><path d="M16 68 103 27 79 104 57 76 16 68Z"/><path d="m57 76 46-49"/></svg></div>
</section>

<section class="stats-grid" aria-label="Current records">
  <article class="stat-card"><span>Passengers</span><strong><%= counts.passengers %></strong><a href="/passengers">View passengers</a></article>
  <article class="stat-card stat-blue"><span>Upcoming flights</span><strong><%= counts.flights %></strong><a href="/flights">View flights</a></article>
  <article class="stat-card stat-pink"><span>Reservations</span><strong><%= counts.reservations %></strong><a href="/reservations">Manage bookings</a></article>
</section>

<section class="section-block">
  <div class="section-title"><div><p class="eyebrow">Tools for today</p><h2>Operations shortcuts</h2></div></div>
  <div class="shortcut-grid">
    <a href="/flights"><span>01</span><strong>Find a flight</strong><small>Schedules, routes and fares</small></a>
    <a href="/checkin"><span>02</span><strong>Check in</strong><small>Find a ticket and issue boarding pass</small></a>
    <a href="/reports"><span>03</span><strong>View reports</strong><small>Seats, bookings and route income</small></a>
  </div>
</section>

<%- include('partials/footer') %>
