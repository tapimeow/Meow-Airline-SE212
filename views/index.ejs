<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#e4f0fd">
  <title>Meow Airline</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="app-body">
  <header class="app-header">
    <a href="#home" class="brand"><span class="brand-mark" aria-hidden="true">M</span><span>Meow Airline<small>Operations desk</small></span></a>
    <button class="menu-toggle" type="button" aria-label="Toggle navigation" aria-expanded="false">Menu</button>
    <nav class="app-nav" aria-label="Main navigation">
      <a href="#home" data-view="home">Overview</a>
      <a href="#passengers" data-view="passengers">Passengers</a>
      <a href="#flights" data-view="flights">Flights</a>
      <a href="#reservations" data-view="reservations">Bookings</a>
      <a href="#checkin" data-view="checkin">Check-in</a>
      <a href="#reports" data-view="reports">Reports</a>
      <details class="nav-more"><summary>Manage</summary><div class="nav-menu">
        <a href="#airports" data-view="airports">Airports & routes</a><a href="#fleet" data-view="fleet">Fleet & seats</a>
        <a href="#staff" data-view="staff">Staff</a><a href="#baggage" data-view="baggage">Baggage</a>
      </div></details>
    </nav>
  </header>
  <main class="app-main">
    <div id="notice" class="notice" role="status" aria-live="polite" hidden></div>
    <div id="app" aria-live="polite"><div class="loading-state">Loading Meow Airline…</div></div>
  </main>
  <footer class="app-footer"><span>Meow Airline</span><span>SE212 · Booking and operations</span></footer>
  <script src="/js/main.js" defer></script>
</body>
</html>
