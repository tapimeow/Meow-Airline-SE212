<%- include('partials/header', { title }) %>

<section class="pass" aria-label="Meow Airline welcome">
  <div class="pass-main">
    <h1>Meow Airline</h1>
    <p>The operations desk is open. Book passengers, take payment, check them in, and read the reports, all on one shared database.</p>
    <dl class="pass-fields">
      <div><dt>From</dt><dd>Front desk</dd></div>
      <div><dt>To</dt><dd>Boarding gate</dd></div>
      <div><dt>Gate</dt><dd>P1</dd></div>
      <div><dt>Seat</dt><dd>Window</dd></div>
    </dl>
  </div>
  <div class="pass-stub">
    <svg class="pass-plane" viewBox="0 0 56 56" aria-hidden="true">
      <path d="M6 26 50 6 38 50 28 33z" fill="#A9CCF4" stroke="#2A3566" stroke-width="2.5" stroke-linejoin="round"/>
      <path d="M28 33 50 6" fill="none" stroke="#2A3566" stroke-width="2.5" stroke-linecap="round"/>
    </svg>
    <a class="btn" href="/reservations/new">New booking</a>
    <div class="barcode" aria-hidden="true"></div>
  </div>
</section>

<h2 class="terminal-title">At the terminal</h2>
<ul class="terminal">
  <li><strong>Flights</strong><span>Routes and schedules</span><br><a class="btn btn-sm btn-quiet" href="/flights">Open</a></li>
  <li><strong>Bookings</strong><span>Reservations and tickets</span><br><a class="btn btn-sm btn-quiet" href="/reservations">Open</a></li>
  <li><strong>Check-in</strong><span>Boarding passes and baggage</span><br><a class="btn btn-sm btn-quiet" href="/checkin">Open</a></li>
  <li><strong>Reports</strong><span>Free seats, bookings, route income</span><br><a class="btn btn-sm btn-quiet" href="/reports">Open</a></li>
</ul>

<%- include('partials/footer') %>
