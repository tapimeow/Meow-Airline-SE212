<%- include('../partials/header', { title }) %>
<header class="page-head print-hide"><div><p class="eyebrow">Meow Airline</p><h1>Boarding pass</h1></div><div class="action-row"><button class="btn btn-quiet" onclick="window.print()" type="button">Print pass</button><a href="/checkin">Back to check-in</a></div></header>
<% if (error) { %><p class="error-message"><%= error %></p><% } %>
<article class="boarding-pass print-pass"><div><p class="eyebrow"><%= boardingPass.FlightNo %> · Boarding pass</p><h2><%= boardingPass.OriginCode %> → <%= boardingPass.DestinationCode %></h2><p><%= boardingPass.Traveller %></p></div><dl><div><dt>Departure</dt><dd><%= formatFlightTime(boardingPass.DepartureTime) %></dd></div><div><dt>Arrival</dt><dd><%= formatFlightTime(boardingPass.ArrivalTime) %></dd></div><div><dt>Gate</dt><dd><%= boardingPass.Gate || 'To be announced' %></dd></div><div><dt>Seat</dt><dd><%= boardingPass.SeatNo %> · <%= boardingPass.SeatClass %></dd></div><div><dt>Boarding pass no.</dt><dd><%= boardingPass.BoardingPassNo %></dd></div></dl></article>
<%- include('../partials/footer') %>
