<%- include('../partials/header', { title }) %>
<header class="page-head"><div><p class="eyebrow">Departure desk</p><h1>Check-in</h1></div></header>
<% if (error) { %><p class="error-message"><%= error %></p><% } %>
<p class="page-intro">Search by reservation number or passenger passport. Check-in is available for issued tickets before departure.</p>
<form class="filter-form" action="/checkin" method="GET"><label>Reservation number<input name="reservationId" type="number" min="1" value="<%= reservationId || '' %>"></label><label>Passport number<input name="passportNo" value="<%= passportNo || '' %>"></label><button class="btn">Find tickets</button></form>
<% if (tickets && tickets.length) { %><div class="table-card"><table class="data-table"><thead><tr><th>Traveller</th><th>Flight</th><th>Departure</th><th>Seat</th><th>Ticket status</th><th>Action</th></tr></thead><tbody><% tickets.forEach(function(t) { %><tr><td data-label="Traveller"><%= t.Traveller %></td><td data-label="Flight"><%= t.FlightNo %></td><td data-label="Departure"><%= formatFlightTime(t.DepartureTime) %></td><td data-label="Seat"><%= t.SeatNo %></td><td data-label="Status"><%= t.TicketStatus %></td><td data-label="Action"><% if (t.CheckInID) { %><a class="btn btn-sm" href="/checkin/<%= t.CheckInID %>/boarding-pass">View pass</a><% } else if (t.TicketStatus === 'issued') { %><form action="/checkin/<%= t.TicketID %>" method="POST"><button class="btn btn-sm">Check in</button></form><% } else { %><span class="muted">Issue ticket first</span><% } %></td></tr><% }); %></tbody></table></div><% } else if (reservationId || passportNo) { %><p class="empty-state">No matching tickets found.</p><% } %>
<%- include('../partials/footer') %>
